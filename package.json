{
  "name": "offline-accounting-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "description": "A synthetic-data accounting development foundation.",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "check:all": "node scripts/check.mjs --browser",
    "progress": "node scripts/progress.mjs",
    "progress:validate": "node scripts/progress.mjs --validate"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "27.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
